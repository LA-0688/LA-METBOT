# Copy this file to .env and fill in real values. NEVER commit .env.
# All values below are placeholders.

# Telegram bot token from @BotFather (optional - bot disabled if unset)
TELEGRAM_TOKEN=your-telegram-bot-token-here

# Optional commercial weather fallbacks (app works without them)
AVWX_API_KEY=your-avwx-api-key-here
CHECKWX_API_KEY=your-checkwx-api-key-here

# Set to 0 to disable the Telegram long-polling thread
# (required if you run more than one Gunicorn worker)
RUN_BOT=1
